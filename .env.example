# URL del gateway OTLP de tu stack. Formato:
#   https://otlp-gateway-<zona>.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=

# Credencial. El formato que espera OpenTelemetry es una lista "clave=valor", y
# Grafana Cloud usa Basic con el base64 de "<instanceID>:<token>":
#
#   OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <credencial-en-base64>"
#
# Las comillas son necesarias porque el valor tiene un espacio. Docker Compose y
# Node (--env-file) las remueven al leer el archivo, pero sin ellas un `source`
# desde la shell corta el valor en el espacio y la variable queda vacía.
#
# El asistente de Grafana muestra estas variables listas para pegar en una shell:
# al traerlas acá, quitales el "export" y dejá las comillas. Si el asistente da
# solo el base64, anteponele "Authorization=Basic " a mano — sin ese prefijo la
# cadena se interpreta como una cabecera de nombre raro y valor vacío, y la
# autenticación falla con 401.
OTEL_EXPORTER_OTLP_HEADERS=
